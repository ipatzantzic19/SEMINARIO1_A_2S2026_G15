{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadVisibleImages",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::semisocial-g15-images-581117996165/Fotos_Perfil/*",
        "arn:aws:s3:::semisocial-g15-images-581117996165/Fotos_Publicadas/*"
      ]
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::semisocial-g15-images-581117996165",
        "arn:aws:s3:::semisocial-g15-images-581117996165/*"
      ],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}

