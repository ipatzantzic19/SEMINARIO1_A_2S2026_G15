# Semi-Social G15 - API Python en EC2 (PRO-17).
# Plantilla de /etc/semisocial/python.env (root:root 0600). La lee systemd con
# EnvironmentFile=, no la app. NO versionar el archivo real.
#
# Reglas (backend-python/app/config.py, APP_ENV=production):
# - [OBLIGATORIA]   la API no arranca (código 2) si falta o está vacía.
# - [RESTRICCIÓN]   la API no arranca si tiene un valor prohibido.
# - [RECOMENDADA]   no la exige config.py, pero sin ella falla en producción.
# - Sin marca:      opcional; el comentario indica el valor por defecto.
# - Los valores <...> son marcadores que se deben reemplazar.
# - Formato EnvironmentFile: NOMBRE=valor, sin "export", sin espacios
#   alrededor de "=".
# - NUNCA definir aquí RDS_PASSWORD, AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY:
#   la contraseña se lee de SSM en cada arranque y las credenciales AWS salen
#   del instance profile.

# --- Entorno -------------------------------------------------------------------
# [RESTRICCIÓN] local | production. Ausente => production. En la EC2: production.
APP_ENV=production
# [RESTRICCIÓN] Debe ser false (o ausente) con APP_ENV=production.
MOCK_MODE=false
# Puerto del target group del ALB. Por defecto 3000.
PORT=3000
# Por defecto 0.0.0.0 en production (necesario para el ALB).
HOST=
# Por defecto /api/v1. Debe coincidir con Node y con el frontend.
API_BASE_PATH=
# [RESTRICCIÓN] INFO | WARNING | ERROR (DEBUG prohibido en production). Por defecto INFO.
LOG_LEVEL=
# [RESTRICCIÓN] Orígenes separados por coma, sin '*'. Vacío = sin CORS.
# Depende de la decisión de HTTPS (README §h): con CloudFront /api/* el
# origen es el mismo y puede quedar vacío.
CORS_ALLOWED_ORIGINS=

# --- Amazon Cognito ------------------------------------------------------------
# [OBLIGATORIA]
AWS_REGION=<region, p. ej. us-east-1>
# [OBLIGATORIA] Formato <region>_<id>.
COGNITO_USER_POOL_ID=<id del user pool>
# [OBLIGATORIA] Cliente semisocial-g15-web (con ALLOW_USER_PASSWORD_AUTH).
COGNITO_APP_CLIENT_ID=<id del app client>
# Opcionales: se derivan de AWS_REGION + COGNITO_USER_POOL_ID. Si se define,
# COGNITO_ISSUER debe coincidir con ellos.
COGNITO_ISSUER=
COGNITO_JWKS_URI=
# [RESTRICCIÓN] Prohibida con APP_ENV=production: no definirla.
# AUTH_LOCAL_PUBLIC_KEY_FILE=
# 1-30 s. Por defecto 5.
COGNITO_TIMEOUT_SECONDS=

# --- Amazon RDS PostgreSQL -----------------------------------------------------
# [OBLIGATORIA] Endpoint de semisocial-g15-postgres (docs/evidence/rds/report.md).
RDS_HOST=<endpoint del RDS>
# Por defecto 5432.
RDS_PORT=
# Por defecto semisocial.
RDS_DATABASE=
# [OBLIGATORIA]
RDS_USER=<usuario de la base>
# [OBLIGATORIA en config.py] RDS_PASSWORD NO va aquí: fetch_rds_password.py la
# lee de este parámetro SSM (SecureString) en cada arranque.
RDS_PASSWORD_SSM_PARAMETER=/semi-social/prod/rds/master-password
# [RESTRICCIÓN] require | verify-ca | verify-full. Por defecto verify-full.
RDS_SSLMODE=verify-full
# [RECOMENDADA] Necesaria con verify-full; bootstrap.sh descarga aquí el bundle.
RDS_SSLROOTCERT=/opt/semisocial/certs/us-east-1-bundle.pem
# Alternativa a RDS_HOST/RDS_USER/RDS_PASSWORD. No usar en la EC2: incluiría
# la contraseña.
# DATABASE_URL=
# Por defecto 1 y 10 (H8: comparar con max_connections junto con Node).
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=
# 1-60 s. Por defecto 5.
DB_CONNECT_TIMEOUT=

# --- Amazon S3 -----------------------------------------------------------------
# [OBLIGATORIA]
S3_IMAGES_BUCKET=<bucket de imágenes>
# Opcionales; por defecto los prefijos del contrato.
S3_PROFILE_PREFIX=
S3_FACE_REFERENCE_PREFIX=
S3_FACE_CAPTURE_PREFIX=
S3_POSTS_PREFIX=
# 1-30 s. Por defecto 5.
S3_TIMEOUT_SECONDS=

# --- Amazon Translate (opcional) -----------------------------------------------
# Por defecto AWS_REGION.
TRANSLATE_REGION=
TRANSLATE_TIMEOUT_SECONDS=

# --- Amazon Lex V2 (opcional) --------------------------------------------------
# Se definen juntas (10 caracteres cada una); sin ellas /bot/messages responde 503.
# [RESTRICCIÓN] LEX_BOT_ALIAS_ID no puede ser TSTALIASID en production.
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
# Por defecto es_419.
LEX_LOCALE_ID=
LEX_REGION=
LEX_TIMEOUT_SECONDS=
