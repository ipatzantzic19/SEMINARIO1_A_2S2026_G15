    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "29.1.1",
    "typescript": "^5.9.0",
