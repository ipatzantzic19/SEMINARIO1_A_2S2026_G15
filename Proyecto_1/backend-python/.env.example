# Semi-Social - Backend Python (FastAPI). Copiar a .env (no versionar .env).
# Los nombres comunes coinciden con backend-node/.env.example.

# --- Entorno ---------------------------------------------------------------
# local | production. Si se omite se asume production (fail closed).
APP_ENV=local
# Solo paridad con Node; nunca válido con APP_ENV=production.
MOCK_MODE=false
PORT=3000
# Por defecto 127.0.0.1 en local y 0.0.0.0 en production.
# HOST=127.0.0.1
API_BASE_PATH=/api/v1
LOG_LEVEL=INFO
# Orígenes separados por coma (sin '*'). Vacío = sin CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Amazon Cognito --------------------------------------------------------
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_4UrrCPt8Z
COGNITO_APP_CLIENT_ID=1feavcj8qvobr4ltshlgnolg5f
# Opcionales: se derivan de AWS_REGION + COGNITO_USER_POOL_ID.
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_4UrrCPt8Z
# COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_4UrrCPt8Z/.well-known/jwks.json
# Solo APP_ENV=local: llave pública PEM para tokens de scripts/local_token.py.
# AUTH_LOCAL_PUBLIC_KEY_FILE=.local/jwt-public.pem

# --- Amazon RDS PostgreSQL -------------------------------------------------
# Opción A: variables separadas. Opción B: DATABASE_URL (armada desde SSM).
RDS_HOST=localhost
RDS_PORT=5432
RDS_DATABASE=semisocial
RDS_USER=postgres
RDS_PASSWORD=
# production exige require, verify-ca o verify-full.
RDS_SSLMODE=prefer
# Ruta al bundle de CA de RDS (necesaria para verify-full en EC2).
# RDS_SSLROOTCERT=/etc/ssl/rds/global-bundle.pem
# DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=5

# --- Amazon S3 -------------------------------------------------------------
S3_IMAGES_BUCKET=semisocial-g15-images-581117996165
S3_PROFILE_PREFIX=Fotos_Perfil/public/
S3_FACE_REFERENCE_PREFIX=Fotos_Perfil/references/
S3_FACE_CAPTURE_PREFIX=Fotos_Perfil/captures/
S3_POSTS_PREFIX=Fotos_Publicadas/
