# TaskFlow + CloudDrive - API Node.js (NestJS). Valores de ejemplo, SIN secretos reales.
# Copiar a .env (ignorado por git) y completar con los valores del entorno.

# --- PostgreSQL (Amazon RDS) ---
DB_HOST=replace-with-rds-endpoint
DB_PORT=5432
DB_NAME=taskflow
DB_USER=replace-with-private-login
DB_PASSWORD=replace-with-secret-store-value
# En RDS: verify-full + bundle de AWS. Solo en el PostgreSQL local de Docker: disable.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/taskflow/rds-global-bundle.pem

# --- Servidor ---
PORT=3000

# --- JWT (mismo secreto que el backend Python) ---
JWT_SECRET=replace-with-private-secret
JWT_EXPIRES_IN=3600

# --- CORS: orígenes separados por coma; vacío desactiva CORS ---
CORS_ORIGINS=http://localhost:5173



