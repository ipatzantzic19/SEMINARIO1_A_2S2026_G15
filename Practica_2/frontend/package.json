{
  "name": "taskflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:hosting": "tsc --noEmit && vite build && node scripts/prepare-hosting.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.4",
    "axios": "1.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2"
  }
}
