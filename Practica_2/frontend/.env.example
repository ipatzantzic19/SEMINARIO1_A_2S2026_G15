# Todas las variables VITE_* terminan en el cliente: NUNCA incluir secretos.
VITE_APP_MODE=mock
VITE_DEFAULT_CLOUD=aws
VITE_API_TIMEOUT_MS=20000

# Bases sin /api/v1 ni /upload. Gateway/APIM pueden incluir su prefijo/stage.
VITE_AWS_API_BASE_URL=
VITE_AWS_UPLOAD_BASE_URL=
VITE_AZURE_API_BASE_URL=
VITE_AZURE_UPLOAD_BASE_URL=
