# TaskFlow + CloudDrive - API Python en EC2 (PRA2-12). SIN secretos reales.
#
# instalar_ec2.sh lo copia a /etc/taskflow/python.env (root:taskflow, 640) solo
# si ese archivo no existe. Editar ALLÍ, en el servidor, y reemplazar cada valor
# que empiece por REEMPLAZAR_; el servicio no se inicia mientras quede alguno.
#
# Formato de EnvironmentFile de systemd: VARIABLE=valor, sin comillas ni
# comentarios al final de la línea.

# --- PostgreSQL: Amazon RDS taskflow-g15 ---
DB_HOST=taskflow-g15.cmpaiquocfxf.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=taskflow
# Usuario de aplicación (rol taskflow_app), nunca el usuario maestro.
DB_USER=taskflow_api
# La entrega Isai por canal privado; no se guarda en ningún otro lugar.
DB_PASSWORD=REEMPLAZAR_con_la_contrasena_de_taskflow_api
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/taskflow/global-bundle.pem

# --- Servidor ---
PORT=3000

# --- JWT: el MISMO secreto que el backend Node.js ---
JWT_SECRET=REEMPLAZAR_con_el_secreto_JWT_compartido
JWT_EXPIRES_IN=3600

# --- CORS: orígenes del frontend separados por coma (vacío = sin CORS) ---
# Cada origen con esquema, sin ruta ni barra final. Ejemplo de formato:
#   CORS_ORIGINS=http://localhost:3000,http://sitio-s3.example,https://sitio-azure.example
CORS_ORIGINS=REEMPLAZAR_con_los_origenes_del_frontend_separados_por_coma
