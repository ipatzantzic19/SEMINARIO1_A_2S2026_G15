flowchart LR
    USUARIOS["<b>USUARIOS</b><br/><br/><b>PK</b> id : BIGINT<br/><b>UK</b> correo_electronico : VARCHAR(254)<br/>nombre_completo : VARCHAR(150)<br/>contrasena_md5 : CHAR(32)<br/>clave_foto_perfil : VARCHAR(1024)<br/>creado_en : TIMESTAMPTZ<br/>actualizado_en : TIMESTAMPTZ"]

    LISTA_REPRODUCCION["<b>LISTA_REPRODUCCION</b><br/><br/><b>PK, FK</b> usuario_id : BIGINT<br/><b>PK, FK</b> pelicula_id : BIGINT<br/>agregado_en : TIMESTAMPTZ"]

    PELICULAS["<b>PELICULAS</b><br/><br/><b>PK</b> id : BIGINT<br/>titulo : VARCHAR(200)<br/>director : VARCHAR(150)<br/>anio_estreno : SMALLINT<br/>url_contenido : TEXT<br/>estado : VARCHAR(20)<br/>clave_portada : VARCHAR(1024)<br/>creado_en : TIMESTAMPTZ<br/>actualizado_en : TIMESTAMPTZ"]

    FOTOS_PERFIL_S3["<b>Amazon S3</b><br/>Fotos_Perfil/"]
    PORTADAS_S3["<b>Amazon S3</b><br/>Fotos_Peliculas/"]

    USUARIOS -->|"1 usuario · 0..N elementos"| LISTA_REPRODUCCION
    PELICULAS -->|"1 película · 0..N elementos"| LISTA_REPRODUCCION
    USUARIOS -. "clave_foto_perfil" .-> FOTOS_PERFIL_S3
    PELICULAS -. "clave_portada" .-> PORTADAS_S3

    classDef entidad fill:#F8FAFC,stroke:#0F172A,stroke-width:2px,color:#0F172A;
    classDef union fill:#EFF6FF,stroke:#2563EB,stroke-width:3px,color:#172554;
    classDef almacenamiento fill:#FFF7ED,stroke:#EA580C,stroke-width:2px,color:#7C2D12;

    class USUARIOS,PELICULAS entidad;
    class LISTA_REPRODUCCION union;
    class FOTOS_PERFIL_S3,PORTADAS_S3 almacenamiento;

    linkStyle 0,1 stroke:#2563EB,stroke-width:2px;
    linkStyle 2,3 stroke:#EA580C,stroke-width:2px,stroke-dasharray:6 4;
