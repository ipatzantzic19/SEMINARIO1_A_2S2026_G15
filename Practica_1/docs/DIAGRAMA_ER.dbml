Project CloudCinema {
  database_type: 'PostgreSQL'
  Note: 'Modelo relacional común para los servidores Node.js y Python.'
}

Table usuarios [headercolor: #1E3A8A] {
  id bigint [pk, increment, note: 'Identificador interno del usuario']
  correo_electronico varchar(254) [not null, unique, note: 'Se almacena normalizado en minúsculas']
  nombre_completo varchar(150) [not null]
  contrasena_md5 char(32) [not null, note: 'MD5 solo por requerimiento académico']
  clave_foto_perfil varchar(1024) [note: 'Clave de S3 bajo Fotos_Perfil/']
  creado_en timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  actualizado_en timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Usuarios registrados en CloudCinema.'
}

Table peliculas [headercolor: #1E3A8A] {
  id bigint [pk, increment, note: 'Identificador interno de la película']
  titulo varchar(200) [not null]
  director varchar(150) [not null]
  anio_estreno smallint [not null]
  url_contenido text [not null]
  estado varchar(20) [not null, note: 'DISPONIBLE o PROXIMO_ESTRENO']
  clave_portada varchar(1024) [not null, note: 'Clave de S3 bajo Fotos_Peliculas/']
  creado_en timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  actualizado_en timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    estado [name: 'ix_peliculas_estado']
  }

  Note: 'Catálogo compartido por ambos servidores.'
}

Table lista_reproduccion [headercolor: #2563EB] {
  usuario_id bigint [not null]
  pelicula_id bigint [not null]
  agregado_en timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (usuario_id, pelicula_id) [pk, name: 'pk_lista_reproduccion']
    (usuario_id, agregado_en) [name: 'ix_lista_reproduccion_usuario_agregado_en']
  }

  Note: 'La clave primaria compuesta evita películas duplicadas por usuario.'
}

Ref fk_lista_reproduccion_usuario {
  usuarios.id < lista_reproduccion.usuario_id [delete: cascade]
}

Ref fk_lista_reproduccion_pelicula {
  peliculas.id < lista_reproduccion.pelicula_id [delete: cascade]
}
