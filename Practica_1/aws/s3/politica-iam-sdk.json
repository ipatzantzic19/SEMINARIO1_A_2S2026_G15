{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketDeImagenes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::practica1-images-g15"
    },
    {
      "Sid": "GestionarImagenes",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::practica1-images-g15/Fotos_Perfil/*",
        "arn:aws:s3:::practica1-images-g15/Fotos_Peliculas/*"
      ]
    }
  ]
}
