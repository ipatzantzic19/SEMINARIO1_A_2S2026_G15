# Copiar como ".env" dentro de api-python/ para desarrollo local con docker-compose.
# Nunca completar ni versionar este archivo de ejemplo con valores reales de RDS.
# NO USAR ESTOS VALORES CONTRA RDS NI EN PRODUCCIÓN — apuntan al Postgres
# efímero de docker-compose.yml, no a Amazon RDS.

BD_HOST=localhost
BD_PUERTO=5433
BD_NOMBRE=cloudcinema
BD_USUARIO=cloudcinema_dev
BD_CONTRASENA=cloudcinema_dev
BD_SSL_MODO=disable
BD_CERTIFICADO_CA=

REGION_AWS=us-east-1
BUCKET_IMAGENES=practica1-images-g15

# Cambiar por un valor propio para desarrollo local; nunca reutilizar este
# valor de ejemplo como si fuera el secreto real compartido con Node.js.
SECRETO_JWT=clave-de-desarrollo-local-cambiar-en-produccion

PORT=8000
