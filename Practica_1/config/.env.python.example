# Copiar como .env.python únicamente en el servidor Python.
# Nunca completar ni versionar este archivo de ejemplo con valores reales.
BD_HOST=
BD_PUERTO=5432
BD_NOMBRE=cloudcinema
BD_USUARIO=usuario_cloudcinema_python
BD_CONTRASENA=
BD_SSL_MODO=verify-full
BD_CERTIFICADO_CA=/etc/ssl/certs/rds-global-bundle.pem

REGION_AWS=us-east-1
BUCKET_IMAGENES=practica1-images-g15
PREFIJO_FOTOS_PERFIL=Fotos_Perfil/
PREFIJO_FOTOS_PELICULAS=Fotos_Peliculas/
SECRETO_JWT=


# Orígenes permitidos para CORS, separados por comas (ej. la URL del ALB o del
# bucket S3 del frontend). Si se deja vacío, el backend usa ["*"] como fallback
# de solo desarrollo — restringir a la URL real antes de la entrega final.
CORS_ORIGINS=

